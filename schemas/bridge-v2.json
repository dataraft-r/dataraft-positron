{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataraft-r.github.io/dataraft.ide/schema/bridge-v2.json",
  "title": "DataRaft IDE explicit source diagnostics v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "generated",
    "kind",
    "request_id",
    "data",
    "error"
  ],
  "properties": {
    "contract": {
      "const": 2
    },
    "generated": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "diagnostics",
        "error"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "truncated"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rule",
                  "status",
                  "severity",
                  "path",
                  "file_hash",
                  "start",
                  "end"
                ],
                "properties": {
                  "rule": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "status": {
                    "enum": [
                      "failed",
                      "error",
                      "warning"
                    ]
                  },
                  "severity": {
                    "enum": [
                      "error",
                      "warning"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "file_hash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "start": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "line",
                      "character"
                    ],
                    "properties": {
                      "line": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "character": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "end": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "line",
                      "character"
                    ],
                    "properties": {
                      "line": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "character": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "items",
              "truncated"
            ],
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rule",
                    "status",
                    "severity",
                    "path",
                    "file_hash",
                    "start",
                    "end"
                  ],
                  "properties": {
                    "rule": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "status": {
                      "enum": [
                        "failed",
                        "error",
                        "warning"
                      ]
                    },
                    "severity": {
                      "enum": [
                        "error",
                        "warning"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "file_hash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "start": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "line",
                        "character"
                      ],
                      "properties": {
                        "line": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "character": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "end": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "line",
                        "character"
                      ],
                      "properties": {
                        "line": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "character": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              },
              "truncated": {
                "type": "boolean"
              }
            }
          },
          "error": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "operation",
        "handle",
        "request_id",
        "response_path"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "operation": {
          "const": "diagnostics"
        },
        "handle": {
          "type": "string",
          "pattern": "^result:",
          "maxLength": 2048
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 128
        },
        "response_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    }
  }
}
