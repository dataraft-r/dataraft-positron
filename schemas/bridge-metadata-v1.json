        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "runs"
        },
        "data": {
          "$ref": "#/$defs/runsCollection"
        },
        "error": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "freshness"
        },
        "data": {
          "$ref": "#/$defs/freshnessCollection"
        },
        "error": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "reports"
        },
        "data": {
          "$ref": "#/$defs/reportsCollection"
        },
        "error": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "product"
        },
        "data": {
